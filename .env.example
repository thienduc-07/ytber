# ==============================================================================
# YTBER - UNIFIED AI VIDEO STUDIO CONFIGURATION
# ==============================================================================

# Environment mode: development | production
ENVIRONMENT=production
PORT=8000

# CORS origins (comma-separated or JSON list)
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173","https://studio.yourdomain.com"]

# Database (Persistent SQLite for zero-config local/self-hosted or PostgreSQL for Cloud)
DATABASE_URL=sqlite+aiosqlite:///./data/ytber.db

# Storage
AUDIO_STORAGE_PATH=./data/audio
ASSET_STORAGE_PATH=./data/assets

# ==============================================================================
# VOICE STUDIO (debpalash/VoiceStudio - AGPL-3.0 Local Neural TTS Engine)
# ==============================================================================
# Run VoiceStudio locally via:
#   git clone https://github.com/debpalash/VoiceStudio.git
#   cd VoiceStudio && uv run python backend/main.py
# Default local port is 3900.
VOICESTUDIO_ENABLED=true
VOICESTUDIO_URL=http://127.0.0.1:3900
VOICESTUDIO_DEFAULT_VOICE=default
VOICESTUDIO_TIMEOUT_SECONDS=30.0

# ==============================================================================
# EDGE-TTS FALLBACK & CACHING
# ==============================================================================
MAX_TTS_CONCURRENCY=2
TTS_TIMEOUT_SECONDS=45.0
TTS_MAX_CHUNK_CHARS=250
TTS_CACHE_ENABLED=true
TTS_CACHE_TTL_SECONDS=604800

# ==============================================================================
# ASSET DISCOVERY & STOCK MEDIA
# ==============================================================================
PEXELS_API_KEY=
ASSET_DOWNLOAD_TIMEOUT_SECONDS=15.0
ASSET_CACHE_ENABLED=true
MAX_ASSET_SIZE_BYTES=20971520

# ==============================================================================
# AI SCRIPT & DIRECTOR PROVIDERS (Optional LLMs for enhanced reasoning)
# ==============================================================================
GROQ_API_KEY=
GEMINI_API_KEY=

# ==============================================================================
# SUPABASE AUTHENTICATION (For Cloud Multi-Tenancy)
# ==============================================================================
SUPABASE_URL=https://placeholder-project.supabase.co
SUPABASE_ANON_KEY=placeholder-anon-key
SUPABASE_SERVICE_ROLE_KEY=placeholder-service-key
SUPABASE_JWT_SECRET=placeholder-jwt-secret-min-32-chars-long
SUPABASE_JWT_AUDIENCE=authenticated
